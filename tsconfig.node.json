{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "resolveJsonModule": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "dist-node",
    "declarationDir": "dist-node",
    "declaration": true,
    "rootDir": ".",

    /* Path aliases */
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@server/*": ["./src/server/*"]
    }
  },
  "include": [
    "electron/**/*.ts",
    "src/server/**/*.ts",
    "src/shared/**/*.ts",
    "prisma/seed.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-electron", "src/renderer", "tests/unit/renderer", "tests/helpers/renderer", "tests/integration/renderer"]
}
