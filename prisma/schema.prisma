// =============================================================
// prisma/schema.prisma — Esquema completo VENDEYA POS
// Semana 2: Multi-empresa, RBAC, SRI Ecuador, Multi-giro
// =============================================================

generator client {
  provider = "prisma-client-js"
  // Motores de consulta que viajan en los instaladores: el del equipo que compila (Windows) y los dos de macOS (Intel y Apple Silicon).
  // electron-builder deja en cada instalador solo los de su plataforma (ver electron-builder.yml).
  binaryTargets = ["native", "darwin", "darwin-arm64"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// EMPRESA, SUCURSAL Y PUNTO DE EMISIÓN
// ─────────────────────────────────────────────

model Empresa {
  id                    String   @id @default(uuid())
  ruc                   String   @unique
  razonSocial           String
  nombreComercial       String
  direccionMatriz       String
  telefono              String
  email                 String
  logo                  String?
  tipoContribuyente     String   // PERSONA_NATURAL | SOCIEDAD | MICRO_EMPRESA | RIMPE_*
  regimenTributario     String   // GENERAL | RIMPE_EMPRENDEDOR | RIMPE_NEGOCIO_POPULAR | MICROEMPRESA
  obligadoContabilidad  Boolean  @default(false)
  agenteRetencion       Boolean  @default(false)
  resolucionAgente      String?
  contribuyenteEspecial String?                      // Nº de resolución (3–13 alfanuméricos) si es contribuyente especial
  ambienteSRI           String   @default("PRUEBAS") // PRUEBAS | PRODUCCION
  status                String   @default("ACTIVO")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  sucursales            Sucursal[]
  usuarios              Usuario[]
  configuracionGiro     ConfiguracionGiro?
  tarifasImpuesto       TarifaImpuesto[]
  listasPrecio          ListaPrecio[]
  comprobantes          ComprobanteElectronico[]
  licencia              Licencia?
}

model Sucursal {
  id        String   @id @default(uuid())
  empresaId String
  codigo    String                        // "001"
  nombre    String
  direccion String
  telefono  String
  status    String   @default("ACTIVO")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa         Empresa          @relation(fields: [empresaId], references: [id])
  puntosEmision   PuntoEmision[]
  turnos          TurnoCaja[]
  ventas          Venta[]
  comprobantes    ComprobanteElectronico[]
  mesas           Mesa[]
  compras         Compra[]
  comandas        Comanda[]
  secuencialComanda Int @default(0)           // Último número de comanda emitido

  @@unique([empresaId, codigo])
}

model PuntoEmision {
  id          String   @id @default(uuid())
  sucursalId  String
  codigo      String                      // "001"
  descripcion String
  secuencialVenta Int  @default(0)            // Último secuencial de venta emitido (se incrementa atómicamente)
  status      String   @default("ACTIVO")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sucursal     Sucursal                 @relation(fields: [sucursalId], references: [id])
  ventas       Venta[]
  comprobantes ComprobanteElectronico[]
  secuenciales SecuencialComprobante[]

  @@unique([sucursalId, codigo])
}

// ─────────────────────────────────────────────
// USUARIOS Y RBAC
// ─────────────────────────────────────────────

model Rol {
  id          String   @id @default(uuid())
  nombre      String   @unique           // ADMIN | SUPERVISOR | CAJERO | BODEGUERO | CONTADOR
  descripcion String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permisos  RolPermiso[]
  usuarios  Usuario[]
}

model Permiso {
  id       String @id @default(uuid())
  modulo   String                         // ventas | inventario | reportes | configuracion | ...
  accion   String                         // crear | leer | actualizar | eliminar | anular | ...
  recurso  String                         // * | venta | producto | usuario | ...

  roles    RolPermiso[]

  @@unique([modulo, accion, recurso])
}

model RolPermiso {
  rolId     String
  permisoId String

  rol     Rol     @relation(fields: [rolId],     references: [id])
  permiso Permiso @relation(fields: [permisoId], references: [id])

  @@id([rolId, permisoId])
}

model Usuario {
  id             String   @id @default(uuid())
  empresaId      String
  rolId          String
  username       String   @unique
  passwordHash   String
  nombre         String
  apellido       String
  email          String?
  cedula         String?
  telefono       String?
  pinCaja        String?                  // PIN numérico de 4–6 dígitos para caja rápida (hash)
  status         String   @default("ACTIVO")
  ultimoAcceso   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  empresa  Empresa   @relation(fields: [empresaId], references: [id])
  rol      Rol       @relation(fields: [rolId],      references: [id])
  turnos   TurnoCaja[]
  ventas   Venta[]
}

// ─────────────────────────────────────────────
// CONFIGURACIÓN DE GIRO Y FEATURE FLAGS
// ─────────────────────────────────────────────

model ConfiguracionGiro {
  id                      String   @id @default(uuid())
  empresaId               String   @unique
  giroNegocio             String                      // RETAIL_GENERAL | FERRETERIA | FARMACIA | RESTAURANTE | ...
  // Módulos
  moduloInventario        Boolean  @default(true)
  moduloKardex            Boolean  @default(true)
  moduloLotes             Boolean  @default(false)
  moduloVencimientos      Boolean  @default(false)
  moduloMesas             Boolean  @default(false)
  moduloComandasCocina    Boolean  @default(false)
  moduloBalanza           Boolean  @default(false)
  moduloListasPrecios     Boolean  @default(false)
  moduloCuentasPorCobrar  Boolean  @default(true)
  moduloCuentasPorPagar   Boolean  @default(true)
  // Facturación SRI
  emitirFacturas          Boolean  @default(true)
  emitirNotasCredito      Boolean  @default(true)
  emitirRetenciones       Boolean  @default(false)
  emitirGuiasRemision     Boolean  @default(false)
  emitirLiquidaciones     Boolean  @default(false)
  // Hardware
  impresionTermica        Boolean  @default(true)
  aperturaGaveta          Boolean  @default(true)
  lecturaCodigoBarras     Boolean  @default(true)
  sincronizacionLAN       Boolean  @default(false)
  modoTactil              Boolean  @default(false)
  // Impresora térmica (ESC/POS)
  impresoraConexion       String   @default("NINGUNA") // NINGUNA | RED (TCP, p. ej. 9100) | SISTEMA (cola de impresión del sistema operativo: USB instalada)
  impresoraDireccion      String?                     // RED: dirección IP o nombre · SISTEMA: nombre de la impresora instalada
  impresoraPuerto         Int      @default(9100)
  impresoraAncho          Int      @default(80)       // Papel en mm: 80 | 58
  // Balanza serial
  balanzaPuerto           String?                     // COM3, /dev/ttyUSB0…
  balanzaBaudios          Int      @default(9600)
  balanzaProtocolo        String   @default("GENERICO") // GENERICO | CAS
  balanzaEtiqueta         String   @default("PESO")     // Qué lleva embebido el código EAN-13 de la balanza: PESO (gramos) | PRECIO (centavos)
  // Certificado digital SRI
  rutaCertificadoP12      String?
  certPasswordEncriptado  String?                     // AES-256-GCM
  certIv                  String?
  certTag                 String?
  certVencimiento         DateTime?
  certTitular             String?                     // CN del certificado (solo informativo)
  certEmisor              String?                     // Autoridad certificadora
  certHuella              String?                     // SHA-1 del certificado (hex)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])
}

// ─────────────────────────────────────────────
// IMPUESTOS DINÁMICOS SRI
// ─────────────────────────────────────────────

model TarifaImpuesto {
  id           String   @id @default(uuid())
  empresaId    String
  tipoImpuesto String                               // IVA | ICE | IRBPNR
  codigo       String                               // "2" = 15%, "0" = 0%, etc.
  porcentaje   Float
  descripcion  String
  vigente      Boolean  @default(true)
  vigenciaDesde DateTime?
  vigenciaHasta DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  empresa   Empresa       @relation(fields: [empresaId], references: [id])
  productos Producto[]

  @@unique([empresaId, tipoImpuesto, codigo])
}

// ─────────────────────────────────────────────
// CATÁLOGO DE PRODUCTOS
// ─────────────────────────────────────────────

model Categoria {
  id          String   @id @default(uuid())
  nombre      String
  descripcion String   @default("")
  status      String   @default("ACTIVO")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productos Producto[]
}

model UnidadMedida {
  id       String   @id @default(uuid())
  codigo   String   @unique            // UN | KG | L | M | CJ | PAQ
  nombre   String
  permiteDecimales Boolean @default(false)   // KG, LB, L, M permiten cantidades fraccionadas
  status   String   @default("ACTIVO")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productos Producto[]
}

model Producto {
  id               String   @id @default(uuid())
  codigo           String   @unique
  codigoBarras     String?
  nombre           String
  descripcion      String?
  tipo             String   @default("BIEN")          // BIEN | SERVICIO
  categoriaId      String
  unidadMedidaId   String
  tarifaImpuestoId String?
  precioCompra     Float    @default(0)
  precioVenta      Float
  margen           Float    @default(0)
  stockMinimo      Float    @default(0)
  stockActual      Float    @default(0)
  costoPromedio    Float    @default(0)               // Kardex costo promedio ponderado
  aplicaIva        Boolean  @default(true)
  codigoIvaSRI     String   @default("4")               // Tabla 17 SRI: "4" = 15 %, "5" = 5 %, "0" = 0 %, "6" no objeto, "7" exento
  tieneVencimiento Boolean  @default(false)
  requiereLote     Boolean  @default(false)
  destinoPreparacion String @default("COCINA")        // Restaurante: COCINA | BARRA
  principioActivo  String?                            // Farmacia
  concentracion    String?                            // Farmacia
  formaFarmaceutica String?                           // Farmacia
  status           String   @default("ACTIVO")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  categoria      Categoria      @relation(fields: [categoriaId],     references: [id])
  unidadMedida   UnidadMedida   @relation(fields: [unidadMedidaId],  references: [id])
  tarifaImpuesto TarifaImpuesto? @relation(fields: [tarifaImpuestoId], references: [id])
  lotes          Lote[]
  kardex         Kardex[]
  lineasVenta    LineaVenta[]
  lineasCompra   LineaCompra[]
  presentaciones PresentacionProducto[]
  preciosLista   PrecioProducto[]
  itemsComanda   ItemComanda[]

  @@index([codigo])
  @@index([codigoBarras])
  @@index([nombre])
}

model Lote {
  id               String   @id @default(uuid())
  productoId       String
  numeroLote       String
  fechaFabricacion DateTime?
  fechaVencimiento DateTime
  cantidadInicial  Float
  cantidadActual   Float
  proveedorId      String?
  status           String   @default("ACTIVO")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  producto    Producto     @relation(fields: [productoId], references: [id])
  proveedor   Proveedor?   @relation(fields: [proveedorId], references: [id])
  lineasVenta LineaVenta[]

  @@unique([productoId, numeroLote])
  @@index([fechaVencimiento])
}

model Kardex {
  id              String   @id @default(uuid())
  productoId      String
  fecha           DateTime @default(now())
  tipoMovimiento  String                            // COMPRA | VENTA | AJUSTE_ENTRADA | AJUSTE_SALIDA | DEVOLUCION
  cantidad        Float
  costoUnitario   Float
  costoTotal      Float
  stockAnterior   Float
  stockResultante Float
  costoPromAnterior Float
  costoPromResultante Float
  referencia      String?                           // ID de venta, compra, ajuste, etc.
  observacion     String?
  createdAt       DateTime @default(now())

  producto Producto @relation(fields: [productoId], references: [id])

  @@index([productoId, fecha])
}

// ─────────────────────────────────────────────
// CLIENTES Y PROVEEDORES
// ─────────────────────────────────────────────

model Cliente {
  id                  String   @id @default(uuid())
  tipoIdentificacion  String   @default("05")       // 04=RUC, 05=Cédula, 06=Pasaporte, 07=Consumidor Final
  identificacion      String
  razonSocial         String
  nombreComercial     String?
  email               String?
  telefono            String?
  direccion           String?
  limiteCredito       Float    @default(0)
  diasCredito         Int      @default(0)
  descuentoHabitual   Float    @default(0)
  status              String   @default("ACTIVO")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  ventas Venta[]
  cuentasPorCobrar CuentaPorCobrar[]
  listaPrecioId    String?
  listaPrecio      ListaPrecio? @relation(fields: [listaPrecioId], references: [id])

  @@unique([tipoIdentificacion, identificacion])
  @@index([identificacion])
  @@index([razonSocial])
}

model Proveedor {
  id                 String   @id @default(uuid())
  ruc                String   @unique
  razonSocial        String
  nombreComercial    String?
  email              String?
  telefono           String?
  direccion          String?
  contacto           String?
  diasPago           Int      @default(30)
  status             String   @default("ACTIVO")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  lotes Lote[]
  compras Compra[]
  cuentasPorPagar CuentaPorPagar[]
}

// ─────────────────────────────────────────────
// TURNOS Y ARQUEOS DE CAJA
// ─────────────────────────────────────────────

model TurnoCaja {
  id               String    @id @default(uuid())
  sucursalId       String
  cajeroId         String
  fechaApertura    DateTime  @default(now())
  fechaCierre      DateTime?
  montoApertura    Float     @default(0)
  montoCierreCiego Float?                           // Lo que el cajero dice que hay
  montoCierreReal  Float?                           // Lo calculado por el sistema
  diferencia       Float?
  estado           String    @default("ABIERTO")   // ABIERTO | CERRADO
  observaciones    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sucursal    Sucursal          @relation(fields: [sucursalId], references: [id])
  cajero      Usuario           @relation(fields: [cajeroId],   references: [id])
  ventas      Venta[]
  movimientos MovimientoCaja[]

  @@index([sucursalId, estado])
}

model MovimientoCaja {
  id          String   @id @default(uuid())
  turnoId     String
  tipo        String                              // INGRESO | EGRESO
  concepto    String
  monto       Float
  referencia  String?
  categoria   String   @default("MANUAL")        // MANUAL | ABONO_CXC | PAGO_CXP
  usuarioId   String?                            // Usuario que registró el movimiento
  createdAt   DateTime @default(now())

  turno TurnoCaja @relation(fields: [turnoId], references: [id])
}

// ─────────────────────────────────────────────
// VENTAS
// ─────────────────────────────────────────────

model Venta {
  id              String   @id @default(uuid())
  numero          String                         // "001-001-000000001" (único por punto de emisión)
  sucursalId      String
  puntoEmisionId  String
  turnoId         String
  cajeroId        String
  clienteId       String?
  clienteRuc      String?
  clienteNombre   String?
  estado          String   @default("COMPLETADA") // BORRADOR | COMPLETADA | ANULADA
  subtotal        Float    @default(0)
  descuento       Float    @default(0)
  iva             Float    @default(0)
  total           Float    @default(0)
  propina         Float    @default(0)            // Propina/servicio: no gravada, se suma al valor a pagar
  motivoAnulacion String?
  fechaAnulacion  DateTime?
  anuladaPorId    String?                        // Usuario que anuló
  observaciones   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sucursal     Sucursal    @relation(fields: [sucursalId],     references: [id])
  puntoEmision PuntoEmision @relation(fields: [puntoEmisionId], references: [id])
  turno        TurnoCaja   @relation(fields: [turnoId],        references: [id])
  cajero       Usuario     @relation(fields: [cajeroId],       references: [id])
  cliente      Cliente?    @relation(fields: [clienteId],      references: [id])
  lineas       LineaVenta[]
  pagos        PagoVenta[]
  comprobante  ComprobanteElectronico?
  cuentaPorCobrar CuentaPorCobrar?
  cobroComanda CobroComanda?

  @@unique([puntoEmisionId, numero])
  @@index([sucursalId, createdAt])
  @@index([clienteId])
  @@index([numero])
}

model LineaVenta {
  id             String  @id @default(uuid())
  ventaId        String
  productoId     String
  loteId         String?
  descripcion    String
  cantidad       Float
  precioUnitario Float
  descuento      Float   @default(0)
  tipoDescuento  String  @default("VALOR")       // PORCENTAJE | VALOR
  subtotal       Float
  iva            Float   @default(0)
  porcentajeIva  Float   @default(0)
  total          Float
  costoUnitario  Float   @default(0)               // Costo por unidad BASE al momento de la venta
  codigoIvaSRI   String   @default("")             // Código de tarifa IVA SRI aplicado (para el XML)
  presentacionId String?                           // Presentación vendida (null = unidad base)
  factorConversion Float  @default(1)              // Unidades base por unidad vendida
  cantidadBase   Float    @default(0)              // Cantidad en unidades base (descontada del stock)

  venta    Venta    @relation(fields: [ventaId],    references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])
  lote     Lote?    @relation(fields: [loteId],     references: [id])
}

model PagoVenta {
  id         String  @id @default(uuid())
  ventaId    String
  formaPago  String                              // EFECTIVO | TARJETA_CREDITO | ... | CREDITO
  monto      Float
  referencia String?
  cambio     Float   @default(0)
  createdAt  DateTime @default(now())

  venta Venta @relation(fields: [ventaId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// FACTURACIÓN ELECTRÓNICA SRI
// ─────────────────────────────────────────────

model ComprobanteElectronico {
  id                   String    @id @default(uuid())
  ventaId              String?   @unique
  compraId             String?                   // Compra que sustenta la retención o la liquidación
  empresaId            String
  sucursalId           String
  puntoEmisionId       String
  claveAcceso          String    @unique         // 49 dígitos
  tipoComprobante      String                    // 01=Factura, 04=N.Crédito, etc.
  ambiente             String    @default("1")   // 1=Pruebas, 2=Producción
  serie                String                    // "001-001"
  secuencial           String                    // "000000001"
  fechaEmision         DateTime
  xmlGenerado          String?                   // XML sin firmar (validado contra el XSD)
  xmlFirmado           String?                   // XML con firma XAdES-BES
  xmlAutorizado        String?                   // XML con nodo de autorización
  estado               String    @default("PENDIENTE") // PENDIENTE|EN_PROCESO|AUTORIZADO|RECHAZADO|DEVUELTO|ANULADO
  numeroAutorizacion   String?
  fechaAutorizacion    DateTime?
  mensajesRespuesta    String?                   // JSON con mensajes del SRI
  motivo               String?                   // Motivo (notas de crédito)
  comprobanteOrigenId  String?                   // Factura que modifica (notas de crédito)
  intentosEnvio        Int       @default(0)
  proximoIntento       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  venta        Venta?       @relation(fields: [ventaId],        references: [id])
  compra       Compra?      @relation(fields: [compraId],       references: [id])
  retenciones  RetencionLinea[]
  empresa      Empresa      @relation(fields: [empresaId],      references: [id])
  sucursal     Sucursal     @relation(fields: [sucursalId],      references: [id])
  puntoEmision PuntoEmision @relation(fields: [puntoEmisionId],  references: [id])
  colaSRI      ColaSRI?
  origen       ComprobanteElectronico?  @relation("ModificaA", fields: [comprobanteOrigenId], references: [id])
  modificadores ComprobanteElectronico[] @relation("ModificaA")

  @@index([comprobanteOrigenId])
  @@index([compraId])
  @@index([estado, proximoIntento])
  @@index([claveAcceso])
}

/// Línea de un comprobante de retención (impuesto retenido sobre un documento de compra)
model RetencionLinea {
  id                String   @id @default(uuid())
  comprobanteId     String
  codigoImpuesto    String                       // 1 = Renta · 2 = IVA · 6 = ISD
  codigoRetencion   String                       // Código de retención del SRI (p. ej. 303, 312, 9, 10…)
  baseImponible     Float
  porcentaje        Float
  valor             Float

  comprobante ComprobanteElectronico @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)

  @@index([comprobanteId])
}

model ColaSRI {
  id               String    @id @default(uuid())
  comprobanteId    String    @unique
  prioridad        Int       @default(5)         // 1 = alta (retención), 10 = baja
  intentos         Int       @default(0)
  ultimoError      String?
  ultimoIntentoAt  DateTime?
  procesandoDesde  DateTime?                     // Para evitar doble procesamiento
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  comprobante ComprobanteElectronico @relation(fields: [comprobanteId], references: [id])

  @@index([prioridad, intentos])
}

// ─────────────────────────────────────────────
// MÓDULO RESTAURANTE: MESAS Y COMANDAS
// ─────────────────────────────────────────────

model Mesa {
  id          String   @id @default(uuid())
  sucursalId  String
  numero      Int
  nombre      String                             // "Mesa 1" | "Barra 2" | "Terraza A"
  capacidad   Int      @default(4)
  zona        String   @default("SALON")
  estado      String   @default("LIBRE")        // LIBRE | OCUPADA | RESERVADA
  status      String   @default("ACTIVO")       // ACTIVO | INACTIVO (la mesa existe en el plano)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sucursal Sucursal  @relation(fields: [sucursalId], references: [id])
  comandas Comanda[]

  @@unique([sucursalId, numero])
}

/// Cuenta de una mesa. Solo puede haber UNA comanda ABIERTA por mesa (se valida en el servicio).
model Comanda {
  id             String    @id @default(uuid())
  sucursalId     String
  numero         Int                                   // Consecutivo por sucursal
  mesaId         String
  meseroId       String?
  comensales     Int       @default(1)
  estado         String    @default("ABIERTA")         // ABIERTA | CERRADA | ANULADA | UNIDA
  observaciones  String?
  divisionPartes Int?                                  // Si se cobra en partes iguales: nº total de partes
  motivoAnulacion String?
  fechaCierre    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sucursal Sucursal       @relation(fields: [sucursalId], references: [id])
  mesa     Mesa           @relation(fields: [mesaId], references: [id])
  items    ItemComanda[]
  cobros   CobroComanda[]

  @@unique([sucursalId, numero])
  @@index([mesaId, estado])
}

model ItemComanda {
  id             String    @id @default(uuid())
  comandaId      String
  productoId     String
  cantidad       Float
  precioUnitario Float                                 // Precio pactado al pedir (sin IVA)
  descuento      Float     @default(0)
  total          Float                                 // cantidad × precio − descuento (sin IVA)
  estado         String    @default("PENDIENTE")       // PENDIENTE | EN_PREPARACION | LISTO | ENTREGADO | CANCELADO
  destino        String    @default("COCINA")          // COCINA | BARRA (copiado del producto al pedir)
  envio          Int       @default(0)                 // Nº de envío a cocina (0 = aún no enviado)
  enviadoAt      DateTime?
  observaciones  String?
  motivoCancelacion String?
  cobrado        Boolean   @default(false)
  ventaId        String?                               // Venta que cobró el ítem (modo por ítems)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  comanda  Comanda  @relation(fields: [comandaId],  references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])

  @@index([estado, destino])
}

/// Cada cobro (venta) de una comanda: por ítems o una parte de la división en partes iguales.
model CobroComanda {
  id         String   @id @default(uuid())
  comandaId  String
  ventaId    String   @unique
  modo       String                                    // ITEMS | PARTE_IGUAL
  parte      Int?                                      // Nº de parte (solo PARTE_IGUAL)
  createdAt  DateTime @default(now())

  comanda Comanda @relation(fields: [comandaId], references: [id])
  venta   Venta   @relation(fields: [ventaId], references: [id])

  @@unique([comandaId, parte])
}

// ─────────────────────────────────────────────
// COMPRAS, CUENTAS POR COBRAR Y POR PAGAR
// ─────────────────────────────────────────────

model Compra {
  id             String   @id @default(uuid())
  proveedorId    String
  sucursalId     String
  usuarioId      String
  numeroFactura  String                            // Nº de la factura del proveedor
  fecha          DateTime
  formaPago      String   @default("CONTADO")      // CONTADO | CREDITO
  subtotal       Float    @default(0)
  iva            Float    @default(0)
  total          Float    @default(0)
  estado         String   @default("REGISTRADA")   // REGISTRADA | ANULADA
  observaciones  String?
  // Documento que sustenta la compra (retenciones, liquidaciones y ATS)
  tipoDocumento  String   @default("FACTURA")      // FACTURA (01) | LIQUIDACION (03: la emite el comprador) | NOTA_VENTA (02)
  codSustento    String   @default("01")           // Tabla de sustento tributario del SRI (2 dígitos)
  autorizacion   String?                           // Nº de autorización del documento del proveedor (10–49 dígitos)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  comprobantes   ComprobanteElectronico[]
  proveedor      Proveedor      @relation(fields: [proveedorId], references: [id])
  sucursal       Sucursal       @relation(fields: [sucursalId], references: [id])
  lineas         LineaCompra[]
  cuentaPorPagar CuentaPorPagar?

  @@unique([proveedorId, numeroFactura])
  @@index([sucursalId, fecha])
}

model LineaCompra {
  id             String  @id @default(uuid())
  compraId       String
  productoId     String
  cantidad       Float
  costoUnitario  Float
  subtotal       Float
  iva            Float   @default(0)
  porcentajeIva  Float   @default(0)
  total          Float

  compra   Compra   @relation(fields: [compraId],  references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])
}

model CuentaPorCobrar {
  id               String   @id @default(uuid())
  ventaId          String   @unique
  clienteId        String
  montoTotal       Float
  saldo            Float
  fechaEmision     DateTime
  fechaVencimiento DateTime
  estado           String   @default("PENDIENTE")  // PENDIENTE | PARCIAL | PAGADA | ANULADA
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  venta   Venta                  @relation(fields: [ventaId],   references: [id])
  cliente Cliente                @relation(fields: [clienteId], references: [id])
  pagos   PagoCuentaPorCobrar[]

  @@index([clienteId, estado])
  @@index([estado, fechaVencimiento])
}

model PagoCuentaPorCobrar {
  id         String   @id @default(uuid())
  cuentaId   String
  monto      Float
  formaPago  String
  referencia String?
  usuarioId  String
  turnoId    String?                                // Turno donde se cobró en efectivo
  fecha      DateTime @default(now())

  cuenta CuentaPorCobrar @relation(fields: [cuentaId], references: [id])

  @@index([cuentaId])
}

model CuentaPorPagar {
  id               String   @id @default(uuid())
  compraId         String   @unique
  proveedorId      String
  montoTotal       Float
  saldo            Float
  fechaEmision     DateTime
  fechaVencimiento DateTime
  estado           String   @default("PENDIENTE")  // PENDIENTE | PARCIAL | PAGADA | ANULADA
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  compra    Compra                @relation(fields: [compraId],    references: [id])
  proveedor Proveedor             @relation(fields: [proveedorId], references: [id])
  pagos     PagoCuentaPorPagar[]

  @@index([proveedorId, estado])
  @@index([estado, fechaVencimiento])
}

model PagoCuentaPorPagar {
  id         String   @id @default(uuid())
  cuentaId   String
  monto      Float
  formaPago  String
  referencia String?
  usuarioId  String
  turnoId    String?
  fecha      DateTime @default(now())

  cuenta CuentaPorPagar @relation(fields: [cuentaId], references: [id])

  @@index([cuentaId])
}

// ─────────────────────────────────────────────
// PRESENTACIONES Y LISTAS DE PRECIOS (Retail / Ferretería)
// ─────────────────────────────────────────────

model PresentacionProducto {
  id           String   @id @default(uuid())
  productoId   String
  nombre       String                              // "Caja x12", "Paquete x6"
  factor       Float                               // Unidades base que contiene
  codigoBarras String?  @unique
  precioVenta  Float?                              // null = precio base × factor
  status       String   @default("ACTIVO")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  producto Producto          @relation(fields: [productoId], references: [id])
  precios  PrecioProducto[]

  @@unique([productoId, nombre])
}

model ListaPrecio {
  id          String   @id @default(uuid())
  empresaId   String
  nombre      String
  descripcion String   @default("")
  status      String   @default("ACTIVO")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  empresa  Empresa          @relation(fields: [empresaId], references: [id])
  precios  PrecioProducto[]
  clientes Cliente[]

  @@unique([empresaId, nombre])
}

model PrecioProducto {
  id             String   @id @default(uuid())
  listaPrecioId  String
  productoId     String
  presentacionId String?                           // null = precio por unidad base
  precio         Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lista        ListaPrecio           @relation(fields: [listaPrecioId], references: [id], onDelete: Cascade)
  producto     Producto              @relation(fields: [productoId], references: [id])
  presentacion PresentacionProducto? @relation(fields: [presentacionId], references: [id])

  @@index([listaPrecioId, productoId])
}

/// Último secuencial emitido por punto de emisión y tipo de comprobante (01 factura, 04 nota de crédito…).
/// Los secuenciales SRI deben ser consecutivos por (establecimiento, punto, tipo).
model SecuencialComprobante {
  id             String   @id @default(uuid())
  puntoEmisionId String
  tipoComprobante String
  ultimo         Int      @default(0)
  updatedAt      DateTime @updatedAt

  puntoEmision PuntoEmision @relation(fields: [puntoEmisionId], references: [id])

  @@unique([puntoEmisionId, tipoComprobante])
}

// ─────────────────────────────────────────────
// SINCRONIZACIÓN MULTI-CAJA (LAN)
// ─────────────────────────────────────────────

/// Bitácora de cambios que el servidor difunde a las cajas por WebSocket (permite reanudar tras una desconexión).
model EventoSync {
  seq        Int      @id @default(autoincrement())
  empresaId  String
  modulo     String                       // ventas, inventario, productos, turnos, comprobantes…
  accion     String                       // POST | PUT | PATCH | DELETE | ESTADO
  ruta       String                       // patrón de la ruta que originó el cambio
  ids        String                       // JSON { parámetro: valor }
  usuarioId  String?
  cajaId     String?
  createdAt  DateTime @default(now())

  @@index([empresaId, seq])
}

/// Licencia de uso de la empresa en ESTE equipo (la firma el servidor de licencias; la aplicación solo la verifica)
model Licencia {
  id               String   @id @default(uuid())
  empresaId        String   @unique
  clave            String   // clave de activación (solo se muestra enmascarada)
  token            String   // licencia firmada: payload.firma (Ed25519)
  dispositivoId    String   // equipo en el que se activó
  ultimaValidacion DateTime // última respuesta correcta del servidor (inicia el período de gracia offline)
  ultimoRelojVisto DateTime // reloj más reciente observado: detecta que se atrasó la fecha del equipo
  bloqueoServidor  String?  // REVOCADA | SUSCRIPCION_VENCIDA | DISPOSITIVO (lo que el servidor respondió en la última validación)
  motivoBloqueo    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  empresa          Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}
