{
  "name": "vendeya-pos",
  "version": "1.1.1",
  "description": "Sistema POS empresarial multi-giro con facturación electrónica SRI Ecuador – Offline-First",
  "author": "VENDEYA",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/claygrefa/VENDEYA-POS.git"
  },
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && node electron/dev-runner.cjs",
    "build": "npm run prisma:generate && npm run build:tsc && npm run build:main && npm run build:vite && npm run build:electron",
    "build:tsc": "tsc --noEmit -p tsconfig.node.json",
    "build:main": "tsc -p tsconfig.electron.json && node -e \"require('fs').cpSync('src/server/services/sri/xsd','dist-electron/src/server/services/sri/xsd',{recursive:true})\"",
    "build:vite": "vite build",
    "build:electron": "electron-builder",
    "build:release:win": "node electron/updater/verificarFirmaRelease.cjs && electron-builder --win --x64 --publish never --config.forceCodeSigning=true",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:estres": "cross-env VENDEYA_ESTRES=1 vitest run tests/stress --testTimeout=600000 --hookTimeout=600000",
    "test:rendimiento": "cross-env VENDEYA_RENDIMIENTO=1 vitest run tests/performance/rendimiento.test.ts --testTimeout=1800000 --hookTimeout=3600000",
    "test:paquete": "node tests/smoke/paquete.smoke.js",
    "smoke-test-install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests/smoke/smoke-test-install.ps1",
    "sri:smoke": "ts-node --project tsconfig.node.json tests/smoke/sriFacturaPruebas.smoke.ts",
    "sri:test-real": "ts-node --project tsconfig.node.json tests/smoke/sriTestReal.smoke.ts",
    "cloud:init": "ts-node --project tsconfig.node.json src/server/cloud/cli.ts init",
    "cloud:migrate": "ts-node --project tsconfig.node.json src/server/cloud/cli.ts migrate",
    "cloud:verify": "ts-node --project tsconfig.node.json tests/smoke/cloudVerify.smoke.ts",
    "release:publish": "ts-node --project tsconfig.node.json electron/updater/release/publicar.ts",
    "release:runbook": "ts-node --project tsconfig.node.json electron/updater/release/runbook.ts",
    "mock:prelanzamiento": "ts-node --project tsconfig.node.json tests/helpers/receptorPrelanzamiento.mock.ts",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint --config tests/config/eslint.config.cjs src electron",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node --project tsconfig.node.json prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/websocket": "^11.3.7",
    "@prisma/client": "^5.22.0",
    "@xmldom/xmldom": "^0.8.15",
    "bwip-js": "^4.11.4",
    "electron-updater": "^6.3.9",
    "fastify": "^5.12.8",
    "iconv-lite": "^0.7.3",
    "node-forge": "^1.3.1",
    "pdfkit": "~0.20.1",
    "pg": "^8.23.1",
    "soap": "^1.0.0",
    "ws": "^8.23.0",
    "xml-crypto": "^6.4.0",
    "xml2js": "^0.6.2",
    "xmlbuilder2": "^4.0.3",
    "xmllint-wasm": "^5.3.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.5.0",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@electron/rebuild": "^4.2.1",
    "@tanstack/react-query": "^5.62.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.9.0",
    "@types/node-forge": "^1.3.11",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.2",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "js-yaml": "^4.1.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.462.0",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "wait-on": "^8.0.1",
    "zustand": "^5.0.1"
  },
  "overrides": {
    "minimatch@>=9 <11.0.1": "^11.0.9"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "electron@45.5.0": true,
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}
