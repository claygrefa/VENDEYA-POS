{
  "name": "vendeya-pos",
  "version": "0.1.0",
  "description": "Sistema POS empresarial multi-giro con facturación electrónica SRI Ecuador – Offline-First",
  "author": "VENDEYA",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "npm run build:main && wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build": "npm run build:tsc && npm run build:main && npm run build:vite && npm run build:electron",
    "build:tsc": "tsc --noEmit -p tsconfig.node.json",
    "build:main": "tsc -p tsconfig.electron.json && node -e \"require('fs').cpSync('src/server/services/sri/xsd','dist-electron/src/server/services/sri/xsd',{recursive:true})\"",
    "build:vite": "vite build",
    "build:electron": "electron-builder",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src electron --ext .ts,.tsx",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node --project tsconfig.node.json prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/websocket": "^10.0.1",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.62.3",
    "electron-updater": "^6.3.9",
    "fastify": "^4.28.1",
    "lucide-react": "^0.462.0",
    "node-forge": "^1.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "soap": "^1.0.0",
    "xml2js": "^0.6.2",
    "xmlbuilder2": "^3.1.1",
    "xmllint-wasm": "^5.3.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.5.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.9.0",
    "@types/node-forge": "^1.3.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.5",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.vendeya.pos",
    "productName": "VENDEYA POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*",
      "prisma/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/renderer/assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/renderer/assets/icon.icns"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "publish": {
      "provider": "github",
      "owner": "vendeya",
      "repo": "vendeya-pos"
    }
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "electron@33.4.11": true,
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.21.5": true
  }
}
